{
  "name": "keystone-mcp",
  "version": "0.2.0",
  "description": "Mount an MCP endpoint with searchTool and callTool on a Keystone 6 app.",
  "license": "MIT",
  "author": "w01fgang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w01fgang/keystone-mcp.git"
  },
  "homepage": "https://github.com/w01fgang/keystone-mcp#readme",
  "bugs": "https://github.com/w01fgang/keystone-mcp/issues",
  "keywords": [
    "keystone",
    "keystone-6",
    "mcp",
    "model-context-protocol",
    "claude",
    "oauth"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\\\n')\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "graphql": "^16.0.0"
  },
  "devDependencies": {
    "@keystone-6/auth": "10.0.6",
    "@keystone-6/cloudinary": "10.0.6",
    "@keystone-6/core": "8.3.0",
    "@keystone-6/fields-document": "11.0.6",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "better-sqlite3": "12.11.1",
    "express": "^4.22.3",
    "graphql": "^16.14.2",
    "prisma": "7.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "module": "./dist/index.js"
}
