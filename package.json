  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "express": "^4.22.3",
    "graphql": "^16.14.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
